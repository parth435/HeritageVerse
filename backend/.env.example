PORT=5000
NODE_ENV=development
# Local direct setup. Production requires the verified proxy hop count (>0 on Render).
TRUST_PROXY_HOPS=0
JWT_SECRET=replace-with-a-generated-secret-of-at-least-32-characters
JWT_EXPIRES_IN=24h
# Local development only. Production requires a non-loopback PostgreSQL URL
# with verified TLS; keep the real connection string in the host secret store.
DATABASE_URL=postgresql://postgres:replace-with-local-password@127.0.0.1:5432/heritageversedb?sslmode=disable
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Optional User-Agent contact override; defaults to the public HeritageVerse repository URL.
HERITAGEVERSE_WIKIMEDIA_CONTACT=
# Optional private OSRM-compatible base URL (for example, an internally hosted service).
# Keep this on the backend. If unset, route calculation returns a clear unavailable response.
ROUTING_BASE_URL=
# Optional direct OpenAI image-edit provider. Keep this key server-side.
HERITAGE_RECONSTRUCTION_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
# Instead of OpenAI, a custom HTTPS provider may implement the request/response
# contract documented in README.md. Never expose either key through a VITE_ variable.
HERITAGE_RECONSTRUCTION_URL=
HERITAGE_RECONSTRUCTION_API_KEY=
