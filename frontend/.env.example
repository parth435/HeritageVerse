# Optional for local development: omit this to use Vite's /api proxy to the
# backend at http://127.0.0.1:5000. This value is only a local example.
VITE_API_BASE_URL=http://localhost:5000
# Vercel Production and Preview deployments must set VITE_API_BASE_URL to the
# public backend origin. VITE_* values are included in the browser bundle.
# Public map tile configuration. Defaults to the standard OpenStreetMap URL.
# Custom providers must include their own visible attribution text and HTTPS link.
# VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_MAP_TILE_ATTRIBUTION=© OpenStreetMap contributors
# VITE_MAP_TILE_ATTRIBUTION_URL=https://www.openstreetmap.org/copyright
