{
  "name": "heritageverse",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "dev:stack": "concurrently -k \"npm run server:dev\" \"npm run dev\"",
    "server:dev": "npm --prefix backend run dev",
    "build": "npm --prefix frontend run build",
    "preview": "npm --prefix frontend run preview",
    "test": "npm --prefix backend test && npm --prefix frontend test",
    "test:migrations": "npm --prefix backend run test:migrations",
    "images:import": "npm --prefix backend run images:import --"
  }
}
